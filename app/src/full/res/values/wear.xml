<?xml version="1.0" encoding="utf-8"?>
<!-- Kept through resource shrinking: only Wear OS reads it, never the app's own code. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities">
    <!-- Tells the Neutrino watch app which paired phone has Neutrino (read by Wear OS). -->
    <string-array name="android_wear_capabilities" translatable="false">
        <item>neutrino_phone</item>
    </string-array>
</resources>
