<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Neutrino" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Splash screen (androidx.core:core-splashscreen) -->
    <style name="Theme.Neutrino.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_coral</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Neutrino</item>
    </style>
</resources>
