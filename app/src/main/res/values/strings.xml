    <!-- Health Connect rationale (shown from Health Connect's permission screen) -->
    <string name="rationale_title">How Neutrino uses Health Connect</string>
    <string name="rationale_body">Neutrino writes the meals and water you approve to Health Connect. It does not read any health data, does not send health data to anyone, and does not use it for advertising.</string>
