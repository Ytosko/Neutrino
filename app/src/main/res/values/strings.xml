    <!-- Health Connect -->
    <string name="hc_title">Connect Health Connect</string>
    <string name="hc_body">Neutrino saves the meals and water you log to Health Connect, so they appear in Google Health, Fitbit and other apps you allow.</string>
    <string name="hc_writes_title">Neutrino will only write</string>
