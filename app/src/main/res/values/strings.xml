    <!-- Welcome -->
    <string name="welcome_tagline">Snap your plate.\nLog your macros.</string>
    <string name="welcome_body">Take a photo of your meal. The AI model you choose estimates carbs, protein, fat and calories, and Neutrino saves it to Health Connect.</string>
    <string name="welcome_point_ai_title">Your AI, your key</string>
    <string name="welcome_point_ai_body">Use Google Gemini or OpenAI with your own API key.</string>
    <string name="welcome_point_review_title">You stay in control</string>
    <string name="welcome_point_review_body">Review every estimate before it\'s saved.</string>
    <string name="welcome_point_privacy_title">Private by design</string>
    <string name="welcome_point_privacy_body">No accounts, no tracking, no Neutrino servers.</string>
    <string name="welcome_get_started">Get started</string>
    <string name="welcome_legal">By continuing you agree to the Terms of Use and Privacy Policy.</string>
    <string name="welcome_disclaimer">Estimates only. Not medical advice.</string>

